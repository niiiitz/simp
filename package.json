{
  "name": "simp-workspace",
  "private": true,
  "version": "0.1.0-alpha.23",
  "workspaces": [
    "packages/simp-client",
    "ui",
    "decky-plugin"
  ],
  "scripts": {
    "dev:ui": "npm --workspace=ui run dev",
    "build:ui": "npm --workspace=ui run build",
    "build:decky": "npm --workspace=decky-plugin run build",
    "build:all": "npm run build:ui && npm run build:decky"
  }
}
