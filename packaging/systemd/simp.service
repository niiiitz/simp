[Unit]
Description=SIMP (Simple Integrated Media Player) Background Audio Daemon
After=pipewire.service pipewire-pulse.service graphical-session.target
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/share/SIMP/simp --daemon
Environment="XDG_RUNTIME_DIR=/run/user/%U"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus"
Environment="MIMALLOC_PURGE_DELAY=100"
Environment="MIMALLOC_RESERVE_ERRORS=0"
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

